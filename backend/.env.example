# the01.dev backend — environment configuration
# Copy to .env and fill in. Never commit the real .env.

# ── Core (required in production) ────────────────────────────────────────────
OPENAI_API_KEY=sk-...                     # LLM + embeddings
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # Neon/Railway Postgres → persistence + pgvector

# ── LLM provider selection ──────────────────────────────────────────────────
# Reliable tutor + QuizMe default to OpenAI when OPENAI_API_KEY is set.
# Set these to "ollama" only for local sovereign-model dev.
# TUTOR_PROVIDER=openai
# LESSON_PROVIDER=openai
# TUTOR_MODEL=gpt-4.1-mini
# LESSON_MODEL=gpt-4.1-mini

# ── Observability (LangSmith) — optional; no-op until set ────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=the01dev

# ── Grounding / behavior ────────────────────────────────────────────────────
# HERMES_GROUNDING_THRESHOLD=0.45

# ── Local dev sovereign model (only if *_PROVIDER=ollama) ────────────────────
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_KEY=ollama

# ── Payments (existing) ─────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
