# the01.dev backend — environment configuration
# Copy to .env and fill in. Never commit the real .env.

# ── Core (required in production) ────────────────────────────────────────────
OPENAI_API_KEY=sk-...                     # LLM + embeddings
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # Neon/Railway Postgres → persistence + pgvector

# ── LLM models (OpenAI is the only provider) ────────────────────────────────
# LESSON_MODEL=gpt-4.1-mini
# EVAL_MODEL=gpt-4.1-mini

# ── Observability (LangSmith) — optional; no-op until set ────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=the01dev

# ── Payments (existing) ─────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
